APP_NAME=SignalRoom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8000
CORS_ALLOWED_ORIGINS="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signalroom
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis
VIDEOCHAT_QUEUE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=replace-with-random-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS="${APP_URL}"

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_TURN_SHARED_SECRET=
WEBRTC_CONNECTION_TIMEOUT_SECONDS=25

VIDEOCHAT_SESSION_TTL_MINUTES=45
VIDEOCHAT_HEARTBEAT_TTL_SECONDS=75
VIDEOCHAT_ROOM_TTL_MINUTES=90
VIDEOCHAT_MATCHMAKING_TIMEOUT_SECONDS=45
VIDEOCHAT_REMATCH_COOLDOWN_SECONDS=120
VIDEOCHAT_REPORT_RETENTION_DAYS=180
VIDEOCHAT_BLOCK_RETENTION_DAYS=30
VIDEOCHAT_FINGERPRINT_KEY=
VIDEOCHAT_FINGERPRINT_ROTATION_DAYS=7
VIDEOCHAT_SIGNAL_MAX_BYTES=12000
VIDEOCHAT_JOIN_LIMIT=30,1
VIDEOCHAT_SKIP_LIMIT=20,1
VIDEOCHAT_REPORT_LIMIT=6,10
VIDEOCHAT_SIGNAL_LIMIT=120,1
VIDEOCHAT_HEARTBEAT_LIMIT=60,1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
